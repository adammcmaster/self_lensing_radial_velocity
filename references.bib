@article{maeder_light_1973,
  title     = {Light {Curves} of the {Gravitational} {Lens}-like {Action} for {Binaries} with {Degenerate} {Stars}},
  volume    = {26},
  issn      = {0004-6361},
  url       = {https://ui.adsabs.harvard.edu/abs/1973A&A....26..215M},
  abstract  = {Summary. The gravitational lens-like action of a star is examined and expressions giving a complete representation of the light curves produced by this effect are obtained. We especially consider the case of binaries, which require new developments, but the usual case of 2 stars very distant from each other is also given in the Appendix. It is to be noted that the case of binaries is the only one which may give reproducible lens effects. The various conditions for visibility of the lens action are also discussed and the relations between the orbital periods of binaries, the geometrical probability of occurence of the lens action, the duration of the effects and their amplitude are established for various kinds of binaries. Lens actions for binaries, which contain at least one main-sequence star, have a very small probability to be observed. But, binaries consisting of two white dwarfs, or of a white dwarf with a neutron star or a black hole, have, if they exist, a geometrical probability to produce gravitational flashes of a given amplitude from 25 to 10 times larger than main-sequence stars. The lens action would give quite a reasonable chance to observe black holes in such degenerate systems, if there is a path in stellar evolution leading to them. Stellar radii could also be estimated by the lens effect. Key words: gravitational lens action-degenerate binaries},
  urldate   = {2026-08-06},
  journal   = {Astronomy and Astrophysics},
  publisher = {EDP},
  author    = {Maeder, A.},
  month     = jul,
  year      = {1973},
  note      = {ADS Bibcode: 1973A\&A....26..215M},
  pages     = {215}
}
